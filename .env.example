# ---------------------------------------------------------------------------
# K-Nyi Portfolio — environment
#
# Copy to `.env.local` and fill in. Never commit the real file: `.env*` is
# already gitignored.
#
# The variables are grouped by kind. A "public id" is safe to appear in the
# browser; a "secret" must only ever be read on the server.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# The password for the /admin console. Production refuses to start without it.
ADMIN_PASSWORD=

# --- Public site ------------------------------------------------------------

# The canonical origin of the site. Used for the canonical URL, the sitemap
# and the social preview image. Leave unset for a local-only install.
NEXT_PUBLIC_SITE_URL=

# The repository sub-path, for a GitHub Pages *project* site. Use an empty
# string once a custom domain is attached.
NEXT_PUBLIC_BASE_PATH=

# The address the SEO audit and the sitemap read the site from, when it is
# different from the public URL.
SITE_INTERNAL_URL=

# --- Public measurement ids (safe in the browser) ---------------------------

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel id
NEXT_PUBLIC_META_PIXEL_ID=

# The address shown in the contact form's "or email" line
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Server-side secrets ----------------------------------------------------

# The Google service account key, as raw JSON or base64. Needs the GA4 Viewer
# role for reporting and Full permission on the Search Console property.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The numeric GA4 property id, for the server-side Data API report
GA4_PROPERTY_ID=

# The Search Console property URL, e.g. https://example.com
SEARCH_CONSOLE_SITE_URL=

# A Meta system-user token with ads_read, for ad performance
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=

# Google Ads, for paid search cost and conversion data
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Resend, for an email the moment an enquiry arrives
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=

# --- Optional ---------------------------------------------------------------

# How long analytics events are kept, in days. Defaults to 180.
ANALYTICS_RETENTION_DAYS=180
