{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knyi-portfolio",
  // Pinned, so no command can land in the wrong account by accident. There
  // are three accounts on this login; only this one is in use.
  "account_id": "e86299bf709f164c49c7743f56829687",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knyi-portfolio",
      "database_id": "2618b69b-1217-4de3-a811-f9e1766aa171",
      "migrations_dir": "src/lib/db/migrations"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "knyi-cache",
      "database_id": "a582a04d-0bdc-43b9-a791-98b88f25205b",
      "migrations_dir": "migrations/cache"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "knyi-uploads"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "knyi-cache"
    }
  ],

  "vars": {
    // The address the site is actually served from. `knyimediabuyer.xyz` is
    // registered at Namecheap and still points at a parking page, so pointing
    // the canonical URL at it would tell a search engine that the real site
    // lives there. When the domain moves to Cloudflare, change this to
    // "https://knyimediabuyer.xyz" and rebuild — it is inlined at build time.
    "NEXT_PUBLIC_SITE_URL": "https://knyi-portfolio.kaungsethmue2001.workers.dev"
  }
}
